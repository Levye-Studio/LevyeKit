{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Levye: Build Debug",
            "type": "shell",
            "command": "levye",
            "args": [
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Levye: Run Debug",
            "type": "shell",
            "command": "levye",
            "args": [
                "run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Levye: Build Debug",
            "problemMatcher": []
        },
        {
            "label": "Levye: Build Release",
            "type": "shell",
            "command": "levye",
            "args": [
                "build",
                "--release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}