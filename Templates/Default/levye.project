[project]
name = "{{PROJECT_NAME}}"
target = "{{PROJECT_TARGET}}"
template_version = 2

[window]
width = 1280
height = 720
target_fps = 60
resizable = true
vsync = false

[paths]
assets = "Assets"

[platform]
default = "{{DEFAULT_PLATFORM}}"

{{ANDROID_CONFIG}}

# Optional desktop distribution metadata (defaults are used when omitted).
# [desktop]
# app_name = "My Game"
# bundle_id = "com.example.mygame"
# version_name = "1.0.0"
# version_code = 1
# icon = "Branding/icon.png"

[modules]
serialization = false
imgui = false
animation = false
physics = false
