[project]
name = "{{PROJECT_NAME}}"
target = "{{PROJECT_TARGET}}"
template_version = 2

{{DISPLAY_CONFIG}}

{{DESKTOP_CONFIG}}

[paths]
assets = "Assets"

[platform]
default = "{{DEFAULT_PLATFORM}}"

{{ANDROID_CONFIG}}
{{IOS_CONFIG}}

[modules]
serialization = false
imgui = false
animation = false
physics = false
