if(NOT DEFINED ENV{TARGET_BUILD_DIR} OR NOT DEFINED ENV{WRAPPER_NAME})
    message(FATAL_ERROR "Xcode bundle destination is unavailable.")
endif()

set(LEVYE_IOS_BUNDLE_DIR "$ENV{TARGET_BUILD_DIR}/$ENV{WRAPPER_NAME}")
if(NOT IS_DIRECTORY "${LEVYE_IOS_BUNDLE_DIR}")
    message(FATAL_ERROR "iOS app bundle does not exist: ${LEVYE_IOS_BUNDLE_DIR}")
endif()

file(REAL_PATH "${LEVYE_IOS_PROJECT_ROOT}" LEVYE_IOS_PROJECT_REAL)
file(REAL_PATH "${LEVYE_IOS_PROJECT_ROOT}/${LEVYE_IOS_ASSET_DIRECTORY}"
    LEVYE_IOS_ASSET_REAL)
cmake_path(IS_PREFIX LEVYE_IOS_PROJECT_REAL "${LEVYE_IOS_ASSET_REAL}"
    NORMALIZE LEVYE_IOS_ASSET_INSIDE)
if(NOT LEVYE_IOS_ASSET_INSIDE OR
   LEVYE_IOS_ASSET_REAL STREQUAL LEVYE_IOS_PROJECT_REAL)
    message(FATAL_ERROR "iOS assets must remain inside the project directory.")
endif()
file(GLOB_RECURSE LEVYE_IOS_ASSET_ENTRIES LIST_DIRECTORIES TRUE
    "${LEVYE_IOS_PROJECT_ROOT}/${LEVYE_IOS_ASSET_DIRECTORY}/*")
foreach(LEVYE_IOS_ASSET_ENTRY IN LISTS LEVYE_IOS_ASSET_ENTRIES)
    if(IS_SYMLINK "${LEVYE_IOS_ASSET_ENTRY}")
        message(FATAL_ERROR "iOS assets cannot contain symbolic links: ${LEVYE_IOS_ASSET_ENTRY}")
    endif()
endforeach()

file(COPY_FILE
    "${LEVYE_IOS_PROJECT_ROOT}/levye.project"
    "${LEVYE_IOS_BUNDLE_DIR}/levye.project")
file(MAKE_DIRECTORY "${LEVYE_IOS_BUNDLE_DIR}/${LEVYE_IOS_ASSET_DIRECTORY}")
file(COPY "${LEVYE_IOS_PROJECT_ROOT}/${LEVYE_IOS_ASSET_DIRECTORY}/"
    DESTINATION "${LEVYE_IOS_BUNDLE_DIR}/${LEVYE_IOS_ASSET_DIRECTORY}")
