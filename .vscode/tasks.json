{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Levye: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/Build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Levye: Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/Build",
                "-j"
            ],
            "dependsOn": "Levye: Configure",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Levye: Run Sandbox",
            "type": "shell",
            "command": "${workspaceFolder}/Targets/Debug/bin/Sandbox",
            "dependsOn": "Levye: Build",
            "problemMatcher": []
        }
    ]
}